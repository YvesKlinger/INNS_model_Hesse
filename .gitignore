# --- Data that must not be published ------------------------------------
# HLNUG (state agency) occurrence data may not be redistributed; it can be
# requested from HLNUG (see README). This includes the combined data set.
StAg Daten/
Occurrences/Occurrence_data_HLNUG/
Occurrences/Occurrence_data_combined/
Finale_occ_Tabellen/all_species_hlnug.csv
Finale_occ_Tabellen/all_species_combined.csv
# Environmental predictors may not be redistributed (sources in README).
Predictors/
Predictors_raw/
Predictors_all_plus_corr/
Shape_Hesse/

# --- Large / derived data ---------------------------------------------
# best_models.zip exceeds GitHub's 100 MB file limit and is not published.
# Metrics.zip (130 KB, per-run AUC/TSS/thresholds) is part of the repository.
RDS files best model per iteration/best_models.zip

# Directories the scripts generate at runtime (model outputs, rasters,
# pseudo-absence samples, intermediate workspaces). Not part of the source
# code and can be regenerated by re-running the pipeline.
Model_results/
Workspace_results/
# Pseudo-absence samples are regenerated by the pipeline; the global
# pseudo-absence areas (made in ArcGIS Pro, see README) are input data.
Pseudo_absences/*
!Pseudo_absences/global/
Pseudo_absences/global/*
!Pseudo_absences/global/pa_area/
PCA_results/
Plots/

# --- R / RStudio artifacts ----------------------------------------------
.Rhistory
.RData
.Rproj.user/
.Ruserdata
Rplots.pdf

# --- OS / editor cruft ----------------------------------------------
.DS_Store
Thumbs.db
